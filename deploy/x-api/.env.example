# Copy to /opt/x-api/.env and chmod 600. Never commit real credentials.
XAPI_IMAGE=x-api:YOUR_COMMIT
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
AUTO_SETUP=true
SERVER_MODE=release
DATABASE_USER=xapi
DATABASE_DBNAME=xapi
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_SSLMODE=disable
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
DEFAULT_USER_BALANCE=0
TZ=Asia/Shanghai
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
